{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Phase result: shared definitions",
  "description": "Definitions every phase result uses (R-257 T2). Model text is capped at 4000 characters with no control characters except tab and newline.",
  "$defs": {
    "v": { "type": "integer", "enum": [1] },
    "feature": { "type": "string", "maxLength": 100, "pattern": "[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}" },
    "timestamp": {
      "type": "string",
      "maxLength": 40,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
    },
    "sha": { "type": "string", "maxLength": 40, "pattern": "[0-9a-f]{40}" },
    "token": { "type": "string", "maxLength": 64, "pattern": "[A-Za-z0-9_.:-]{1,64}" },
    "id": { "type": "string", "maxLength": 128, "pattern": "[A-Za-z0-9_.:-]{1,128}" },
    "source": { "type": "string", "enum": ["code", "model", "agent"] },
    "modelText": { "type": "string", "maxLength": 4000, "pattern": "[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*" },
    "shortText": { "type": "string", "maxLength": 400, "pattern": "[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*" },
    "count": { "type": "integer", "minimum": 0 },
    "verification": { "type": "string", "enum": ["verified", "unverified"] },
    "verificationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "errorClass"],
      "properties": {
        "check": { "$ref": "#/$defs/token" },
        "errorClass": { "$ref": "#/$defs/token" }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind"],
        "properties": {
          "text": { "$ref": "#/$defs/modelText" },
          "kind": { "$ref": "#/$defs/token" },
          "label": { "type": "string", "enum": ["VERIFIED", "REFUTED", "UNVERIFIABLE"] },
          "evidence": { "$ref": "#/$defs/modelText" }
        }
      }
    },
    "chain": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "ranAt", "initEventId"],
        "properties": {
          "command": { "$ref": "#/$defs/token" },
          "ranAt": { "$ref": "#/$defs/timestamp" },
          "initEventId": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
